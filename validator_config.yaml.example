# SN94 backend weight-setter configuration.
#
# This file is for `python -m validator.backend_weight_setter` and
# `bitsota-backend-weights`. The legacy relay/local validator weight path has
# been removed; production validators should get targets from the autoresearch
# backend reward snapshot.

# Bittensor Network Configuration
netuid: 94
wallet_name: "wallet_name"
wallet_hotkey: "wallet_hotkey"
path: "~/.bittensor/wallets/"
network: "finney"  # Use "test" for testnet, "finney" for mainnet
epoch_length: 100
subtensor_chain_endpoint: "wss://entrypoint-finney.opentensor.ai:443"

# Weight submission behavior.
weights:
  wait_for_inclusion: true
  wait_for_finalization: false
