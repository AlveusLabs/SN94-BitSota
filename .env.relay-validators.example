# Relay target
# Use hosted relay by default.
RELAY_URL=https://relay.bitsota.com

# For optional local relay profile:
# RELAY_URL=http://relay:8002
# RELAY_PORT=8002
# RELAY_SOURCE_DIR=../BitSota
# RELAY_DOCKERFILE=../current-sn-2/docker/relay.Dockerfile

# Validator wallets (required)
VALIDATOR_1_WALLET_NAME=validator_1
VALIDATOR_1_WALLET_HOTKEY=validator_1_hot
VALIDATOR_2_WALLET_NAME=validator_2
VALIDATOR_2_WALLET_HOTKEY=validator_2_hot

# Bittensor testnet (must match the subnet where your validator hotkeys are registered)
# Example: NETUID=402
NETUID=94
SUBTENSOR_NETWORK=test
SUBTENSOR_CHAIN_ENDPOINT=wss://test.finney.opentensor.ai:443
# Local subtensor override (if your local node runs on the same VM host):
# SUBTENSOR_NETWORK=local
# SUBTENSOR_CHAIN_ENDPOINT=ws://172.17.0.1:9944

# Validator runtime
RELAY_POLL_INTERVAL_SECONDS=60
WEIGHT_POLL_INTERVAL_S=6.0
WEIGHT_RETRY_INTERVAL_S=5.0
EPOCH_LENGTH=360
WINNER_SOURCE=relay
# Must be registered on NETUID (otherwise validator loop will error)
# BURN_HOTKEY=<registered_hotkey_ss58>
BURN_HOTKEY=5Ef5EsPQoMVmJ8rYectQ26BEvscvATEGm365bcQjo1Y6bxGr
BURN_SHARE=0.9
APPLY_WEIGHTS_INLINE=true
SUBMIT_SOTA_VOTES=true
BLACKLIST_CUTOFF_PERCENTAGE=0.1
VALIDATOR_LOG_LEVEL=INFO
