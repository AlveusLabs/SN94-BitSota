# Public autoresearch validator runner config.
# Copy this file to research_validator_config.yaml and edit the wallet values.

# Production autoresearch backend.
coordinator_url: "https://autoresearch.bitsota.com"

# Optional task filter. Leave unset to scan every available recent submission.
# task_id: ""
# task_slug: ""

# Default signed worklist endpoint.
claim_path: "/api/v1/validator/submissions/scan"

# Bittensor wallet used to sign validator requests. Prefer wallet files over
# hotkey_mnemonic in shared or long-lived configs.
wallet_name: "validator-wallet"
wallet_hotkey: "validator-hotkey"
wallet_path: "~/.bittensor/wallets/"
# wallet_file: ""
# hotkey_mnemonic: ""

# Local replay runtime.
workspace_root: ".bitsota_public_validator_workspaces"
cycles: 0
# once: true
interval_seconds: 30
timeout_s: 30

# Replay sandbox. Docker mode keeps submitted setup and benchmark commands out
# of the validator host process while still allowing CUDA when the validator
# host has Docker + NVIDIA Container Toolkit installed.
replay_sandbox_mode: "docker"
replay_sandbox_image: "bitsota-research-validator-cuda:local"
replay_sandbox_dockerfile: "docker/research-validator-cuda.Dockerfile"
replay_sandbox_gpus: "all"
replay_sandbox_setup_network_mode: "none"
replay_sandbox_benchmark_network_mode: "none"
replay_sandbox_memory_limit: "16g"
replay_sandbox_pids_limit: 512
replay_sandbox_cpus: 0
replay_sandbox_workspace_size_bytes: 2147483648
replay_sandbox_result_max_bytes: 10485760

# Host replay executes submitted setup and benchmark commands directly on this
# machine. Keep this false for Docker mode; set true only for an explicitly
# isolated host-mode validator.
allow_unsafe_host_replay: false
allow_local_artifacts: false
max_replay_log_chars: 128000
dry_run: false

# Backend replay_spec returns heldout dataset handles, mix percentages, split,
# sync slot/number selectors, and optional HF row-source JSON to authenticated
# validators. The validator host resolves backend HF rows before Docker starts,
# writes a local manifest into the replay workspace, and passes only local
# manifest paths to the benchmark sandbox.
local_benchmark_env:
  # AUTORESEARCH_PRIVATE_HELDOUT_MANIFEST: "/srv/bitsota/heldout/qwen-frontier-v2/manifest.json"
  # AUTORESEARCH_PRIVATE_HELDOUT_ROOT: "/srv/bitsota/heldout/qwen-frontier-v2"
  # For Hugging Face-backed heldout handles or backend row-source JSON,
  # validators fetch locally outside Docker. Use pinned backend handles like:
  #   hf://org/private-heldout?revision=<commit>&manifest=manifest.json
  # HF_TOKEN: "hf_..."
  # AUTORESEARCH_PRIVATE_HELDOUT_CACHE_DIR: "/srv/bitsota/heldout-cache"
